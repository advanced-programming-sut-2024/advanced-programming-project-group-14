<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.controller.ProfileMenuController" alignment="CENTER" spacing="10" style="-fx-padding: 20;">
    <HBox  alignment="CENTER" spacing="10">
        <Button fx:id="userInfoButton" text="User info" onAction="#handleUserInfoButtonClick"/>
        <HBox spacing="5">
            <TextField fx:id="gameHistoryCount" promptText="Enter number of games"/>
            <Button fx:id="gameHistoryButton" text="Game history" onAction="#handleGameHistoryButtonClick"/>
        </HBox>
    </HBox>

    <GridPane  alignment="CENTER" fx:id="infoGrid" hgap="10" vgap="10" style="-fx-background-color: #1c1c1c; -fx-padding: 20; -fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-border-radius: 5px;">
        <!-- Labels for user information will be added dynamically -->
    </GridPane>

    <TableView fx:id="gameHistoryTable" visible="false" style="-fx-background-color: #0e1a2b; -fx-border-color: #a57a1c; -fx-border-width: 2px;">
        <columns>
            <TableColumn fx:id="opponentColumn" prefWidth="150" text="Opponent" />
            <TableColumn fx:id="dateColumn" prefWidth="150" text="Match Date" />
            <TableColumn fx:id="roundsColumn" prefWidth="150" text="Rounds Score" />
            <TableColumn fx:id="totalColumn" prefWidth="150" text="Total Score" />
            <TableColumn fx:id="winnerColumn" prefWidth="150" text="Winner" />
        </columns>
    </TableView>
</VBox>
