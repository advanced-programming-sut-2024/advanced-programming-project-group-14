<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<GridPane fx:id="mainMenuGrid" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.MainMenuView" alignment="CENTER" hgap="10" vgap="10">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox alignment="CENTER" spacing="20" GridPane.columnSpan="2">
        <Button text="Profile" fx:id="profileButton" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-pref-width: 200px; -fx-pref-height: 40px; -fx-border-radius: 5px;" />
        <Button text="Start Game" fx:id="startGameButton" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-pref-width: 200px; -fx-pref-height: 40px; -fx-border-radius: 5px;" />
        <Button text="Logout" fx:id="logoutButton" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-pref-width: 200px; -fx-pref-height: 40px; -fx-border-radius: 5px;" />
    </VBox>
</GridPane>
