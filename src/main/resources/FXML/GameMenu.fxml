<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.geometry.Insets?>
<GridPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.GameMenuView" fx:id="mainGridPane" alignment="CENTER">

    <!-- Top section for opponent's leader and spell cards -->
    <HBox spacing="50">
        <HBox alignment="CENTER" spacing="50">
            <VBox alignment="CENTER" spacing="50">
                <ImageView fx:id="opponentLeaderImage"/>
                <HBox alignment="CENTER" spacing="20">
                    <Label fx:id="opponentName" text=""/>
                    <Label fx:id="opponentScore" text="0"/>
                </HBox>
                <HBox alignment="CENTER" spacing="20">
                    <Label fx:id="opponentCardCount" text="Cards: 10"/>
                    <Label fx:id="opponentCrystal" text="Crystal: 2"/>
                </HBox>
                <GridPane fx:id="spell" minHeight="120" minWidth="200"
                          style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c;"/>
                <HBox alignment="CENTER" spacing="20">
                    <Label fx:id="currentName" text=""/>
                    <Label fx:id="currentScore" text="0"/>
                </HBox>
                <HBox alignment="CENTER" spacing="20">
                    <Label fx:id="currentCardCount" text="Cards: 10"/>
                    <Label fx:id="currentCrystal" text="Crystal: 2"/>
                </HBox>
                <ImageView fx:id="currentLeaderImage"/>
                <Button fx:id="passButton" text="Pass" onAction="#passTurn"/>
            </VBox>
        </HBox>
        <!-- Center section for the game board -->
        <HBox>
            <VBox>
                <GridPane fx:id="gameBoard" hgap="10" vgap="10" style="-fx-padding: 20;" alignment="CENTER">
                    <!-- Opponent's rows -->
                    <HBox GridPane.rowIndex="0" spacing="5" alignment="CENTER">
                        <GridPane fx:id="opponentSiegeSpecial"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c;"/>
                        <GridPane fx:id="opponentSiege"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c;"/>
                        <Label fx:id="opponentSiegeScore" text="0" styleClass="circular-label"/>
                    </HBox>
                    <HBox GridPane.rowIndex="1" spacing="5" alignment="CENTER">
                        <GridPane fx:id="opponentRangedSpecial"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c;"/>
                        <GridPane fx:id="opponentRanged" GridPane.rowIndex="1" GridPane.columnIndex="0"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c;"/>
                        <Label fx:id="opponentRangedScore" text="0" styleClass="circular-label"/>
                    </HBox>
                    <HBox GridPane.rowIndex="2" spacing="5" alignment="CENTER">
                        <GridPane fx:id="opponentCloseCombatSpecial"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c;"/>
                        <GridPane fx:id="opponentCloseCombat"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c;"/>
                        <Label fx:id="opponentCloseCombatScore" text="0" styleClass="circular-label"/>
                    </HBox>
                    <GridPane fx:id="space" GridPane.rowIndex="3"
                              style="-fx-border-color: #ff5050; -fx-border-width: 2px;"/>
                    <HBox GridPane.rowIndex="4" spacing="5" alignment="CENTER">
                        <GridPane fx:id="playerCloseCombatSpecial"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c;"/>
                        <GridPane fx:id="playerCloseCombat"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c;"/>
                        <Label fx:id="playerCloseCombatScore" text="0" styleClass="circular-label"/>
                    </HBox>
                    <HBox GridPane.rowIndex="5" spacing="5" alignment="CENTER">
                        <GridPane fx:id="playerRangedSpecial"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c;"/>
                        <GridPane fx:id="playerRanged"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c;"/>
                        <Label fx:id="playerRangedScore" text="0" styleClass="circular-label"/>
                    </HBox>
                    <HBox GridPane.rowIndex="6" spacing="5" alignment="CENTER">
                        <GridPane fx:id="playerSiegeSpecial"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c;"/>
                        <GridPane fx:id="playerSiege"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c;"/>
                        <Label fx:id="playerSiegeScore" text="0" styleClass="circular-label"/>
                    </HBox>
                </GridPane>
                <GridPane fx:id="playerHand" GridPane.rowIndex="7" GridPane.columnIndex="0"
                          style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c;"/>
            </VBox>
            <VBox spacing="500">
                <padding>
                    <Insets left="50" top="50" bottom="50"/>
                </padding>
                <HBox spacing="20">
                    <GridPane fx:id="opponentDiscardPile"
                              style="-fx-border-color: #a57a1c;"/>
                    <VBox alignment="CENTER" spacing="10">
                        <ImageView fx:id="opponentDeck"
                                   style="-fx-border-color: #a57a1c;"/>
                        <Label fx:id="opponentDeckSize" text="0"/>
                    </VBox>
                </HBox>
                <HBox spacing="20">
                    <GridPane fx:id="currentDiscardPile"
                              style="-fx-border-color: #a57a1c;"/>
                    <VBox alignment="CENTER" spacing="10">
                        <ImageView fx:id="currentDeck"
                                   style="-fx-border-color: #a57a1c;"/>
                        <Label fx:id="currentDeckSize" text="0"/>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>
    </HBox>
</GridPane>
