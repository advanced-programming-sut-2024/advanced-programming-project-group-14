<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.geometry.Insets?>
<GridPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.GameMenuView" alignment="CENTER">
    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <!-- Top section for opponent's leader and spell cards -->
    <HBox spacing="50">
        <HBox alignment="CENTER" spacing="50">
            <VBox alignment="CENTER" spacing="50">
                <ImageView fx:id="opponentLeaderImage" fitHeight="250" fitWidth="150"/>
                <ImageView fx:id="spellImage" fitHeight="100" fitWidth="200"/>
                <ImageView fx:id="currentLeaderImage" fitHeight="250" fitWidth="150"/>
            </VBox>
            <HBox alignment="BOTTOM_CENTER">
                <padding>
                    <Insets bottom="200"/>
                </padding>
                <Button fx:id="useLeaderActionButton" text="Use Leader Action" prefWidth="200"/>
            </HBox>
        </HBox>
        <!-- Center section for the game board -->
        <HBox>
            <VBox>
                <GridPane fx:id="gameBoard" hgap="10" vgap="10" style="-fx-padding: 20;" alignment="CENTER">
                    <!-- Opponent's rows -->
                    <GridPane fx:id="opponentRow1" GridPane.rowIndex="0" GridPane.columnIndex="0"
                              style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 100; -fx-pref-width: 700;">
                        <!-- Cards will be dynamically added here -->
                    </GridPane>
                    <GridPane fx:id="opponentRow2" GridPane.rowIndex="1" GridPane.columnIndex="0"
                              style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 100; -fx-pref-width: 700;">
                        <!-- Cards will be dynamically added here -->
                    </GridPane>
                    <GridPane fx:id="opponentRow3" GridPane.rowIndex="2" GridPane.columnIndex="0"
                              style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 100; -fx-pref-width: 700;">
                        <!-- Cards will be dynamically added here -->
                    </GridPane>

                    <GridPane fx:id="space" GridPane.rowIndex="3" GridPane.columnIndex="0"
                              style="-fx-border-color: #ff5050; -fx-border-width: 2px; -fx-pref-width: 700;"/>
                    <!-- Player's rows -->
                    <GridPane fx:id="playerRow1" GridPane.rowIndex="4" GridPane.columnIndex="0"
                              style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 100; -fx-pref-width: 700;">
                        <!-- Cards will be dynamically added here -->
                    </GridPane>
                    <GridPane fx:id="playerRow2" GridPane.rowIndex="5" GridPane.columnIndex="0"
                              style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 100; -fx-pref-width: 700;">
                        <!-- Cards will be dynamically added here -->
                    </GridPane>
                    <GridPane fx:id="playerRow3" GridPane.rowIndex="6" GridPane.columnIndex="0"
                              style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 100; -fx-pref-width: 700;">
                        <!-- Cards will be dynamically added here -->
                    </GridPane>
                </GridPane>
                <GridPane fx:id="playerHand" GridPane.rowIndex="7" GridPane.columnIndex="0"
                          style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 100; -fx-pref-width: 700;">
                    <!-- Cards will be dynamically added here -->
                </GridPane>
            </VBox>
            <VBox spacing="500">
                <padding>
                    <Insets left="50" top="50" bottom="50"/>
                </padding>
                <HBox spacing="20">
                    <GridPane fx:id="opponentDiscardPile" style="-fx-border-color: #a57a1c; -fx-pref-height: 150; -fx-pref-width: 100;"/>
                    <GridPane fx:id="opponentDeck" style="-fx-border-color: #a57a1c; -fx-pref-height: 150; -fx-pref-width: 100;"/>
                </HBox>
                <HBox spacing="20">
                    <GridPane fx:id="currentDiscardPile" style="-fx-border-color: #a57a1c; -fx-pref-height: 150; -fx-pref-width: 100;"/>
                    <GridPane fx:id="currentDeck" style="-fx-border-color: #a57a1c; -fx-pref-height: 150; -fx-pref-width: 100;"/>
                </HBox>
            </VBox>
        </HBox>
    </HBox>
</GridPane>
