<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.geometry.Insets?>
<GridPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.GameMenuView" alignment="CENTER">
    <padding>
        <Insets top="50" right="20" bottom="50" left="20"/>
    </padding>

    <!-- Top section for opponent's leader and spell cards -->
    <HBox spacing="50">
        <HBox alignment="CENTER" spacing="50">
            <VBox alignment="CENTER" spacing="50">
                <ImageView fx:id="opponentLeaderImage" fitHeight="190" fitWidth="100"/>
                <VBox alignment="CENTER">
                    <Label fx:id="opponentName" text=""/>
                </VBox>
                <HBox alignment="CENTER" spacing="20">
                    <Label fx:id="opponentCardCount" text="Cards: 10"/>
                    <Label fx:id="opponentCrystal" text="Crystal: 2"/>
                </HBox>
                <GridPane fx:id="spell" maxHeight="50" maxWidth="100"/>
                <VBox alignment="CENTER">
                    <Label fx:id="currentName" text=""/>
                </VBox>
                <HBox alignment="CENTER" spacing="20">
                    <Label fx:id="currentCardCount" text="Cards: 10"/>
                    <Label fx:id="currentCrystal" text="Crystal: 2"/>
                </HBox>
                <ImageView fx:id="currentLeaderImage" fitHeight="190" fitWidth="100"/>
            </VBox>
        </HBox>
        <!-- Center section for the game board -->
        <HBox>
            <VBox>
                <GridPane fx:id="gameBoard" hgap="10" vgap="10" style="-fx-padding: 20;" alignment="CENTER">
                    <!-- Opponent's rows -->
                    <HBox GridPane.rowIndex="0">
                        <GridPane fx:id="opponentSiegeSpecial"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 150; -fx-pref-width: 100;"/>
                        <GridPane fx:id="opponentSiege"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 150; -fx-pref-width: 600;"/>
                    </HBox>
                    <HBox GridPane.rowIndex="1">
                        <GridPane fx:id="opponentRangedSpecial"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 150; -fx-pref-width: 100;"/>
                        <GridPane fx:id="opponentRanged" GridPane.rowIndex="1" GridPane.columnIndex="0"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 150; -fx-pref-width: 600;"/>
                    </HBox>
                    <HBox GridPane.rowIndex="2">
                        <GridPane fx:id="opponentCloseCombatSpecial"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 150; -fx-pref-width: 100;"/>
                        <GridPane fx:id="opponentCloseCombat"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 150; -fx-pref-width: 600;"/>
                    </HBox>
                    <GridPane fx:id="space" GridPane.rowIndex="3"
                              style="-fx-border-color: #ff5050; -fx-border-width: 2px; -fx-pref-width: 700;"/>
                    <HBox GridPane.rowIndex="4">
                        <GridPane fx:id="playerCloseCombatSpecial"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 150; -fx-pref-width: 100;"/>
                        <GridPane fx:id="playerCloseCombat"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 150; -fx-pref-width: 600;"/>
                    </HBox>
                    <HBox GridPane.rowIndex="5">
                        <GridPane fx:id="playerRangedSpecial"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 150; -fx-pref-width: 100;"/>
                        <GridPane fx:id="playerRanged"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 150; -fx-pref-width: 600;"/>
                    </HBox>
                    <HBox GridPane.rowIndex="6">
                        <GridPane fx:id="playerSiegeSpecial"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 150; -fx-pref-width: 100;"/>
                        <GridPane fx:id="playerSiege"
                                  style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 150; -fx-pref-width: 600;"/>
                    </HBox>
                </GridPane>
                <GridPane fx:id="playerHand" GridPane.rowIndex="7" GridPane.columnIndex="0"
                          style="-fx-border-color: #a57a1c; -fx-border-width: 2px; -fx-background-color: #1c1c1c; -fx-pref-height: 150; -fx-pref-width: 600;"/>
            </VBox>
            <VBox spacing="500">
                <padding>
                    <Insets left="50" top="50" bottom="50"/>
                </padding>
                <HBox spacing="20">
                    <GridPane fx:id="opponentDiscardPile"
                              style="-fx-border-color: #a57a1c; -fx-pref-height: 150; -fx-pref-width: 100;"/>
                    <ImageView fx:id="opponentDeck"
                               style="-fx-border-color: #a57a1c; -fx-pref-height: 150; -fx-pref-width: 100;"/>
                </HBox>
                <HBox spacing="20">
                    <GridPane fx:id="currentDiscardPile"
                              style="-fx-border-color: #a57a1c; -fx-pref-height: 150; -fx-pref-width: 100;"/>
                    <ImageView fx:id="currentDeck"
                               style="-fx-border-color: #a57a1c; -fx-pref-height: 150; -fx-pref-width: 100;"/>
                </HBox>
            </VBox>
        </HBox>
    </HBox>
</GridPane>
