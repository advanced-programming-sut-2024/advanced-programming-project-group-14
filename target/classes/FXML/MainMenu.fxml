<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<GridPane fx:id="mainMenuGrid" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.MainMenuView" alignment="CENTER" hgap="10" vgap="10"
          style="-fx-background-image: url('Media/mainMenu.jpg'); -fx-background-size: 100% 100%; -fx-background-insets: 0; -fx-background-position: center center; -fx-background-repeat: no-repeat;">    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox alignment="CENTER" spacing="20" GridPane.columnSpan="2">
        <Button text="Profile" fx:id="profileButton" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-pref-width: 200px; -fx-pref-height: 40px; -fx-border-radius: 5px;" />
        <Button text="Start Game" fx:id="startGameButton" onAction="#startGame" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-pref-width: 200px; -fx-pref-height: 40px; -fx-border-radius: 5px;" />
        <Button text="Score Board" fx:id="scoreBoardButton" onAction="#openScoreBoard" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-pref-width: 200px; -fx-pref-height: 40px; -fx-border-radius: 5px;" />
        <Button text="Score Board" fx:id="chat" onAction="#openChat" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-pref-width: 200px; -fx-pref-height: 40px; -fx-border-radius: 5px;" />
        <Button text="Logout" fx:id="logoutButton" onAction="#logout" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-pref-width: 200px; -fx-pref-height: 40px; -fx-border-radius: 5px;" />
    </VBox>
</GridPane>
